{
  "manifest_version": 3,
  "name": "Clean Window｜乾淨視窗",
  "version": "0.1.0",
  "description": "三級視窗精簡：輕量瀏覽器工具列、自繪網址欄、純內容 Popup；支援視窗清單與按需授權書籤。",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "optional_permissions": ["bookmarks"],
  "incognito": "split",
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {
    "default_title": "Clean Window｜乾淨視窗",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "commands": {
    "toggle-clean": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "依目前簡化等級套用／還原"},
    "toggle-fullscreen": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "整個目標視窗：切換全螢幕"},
    "restore": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "還原目前視窗"},
    "edit-title": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "編輯乾淨模式標題"}
  },
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}
}
